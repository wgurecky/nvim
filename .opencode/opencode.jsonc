{
  "$schema": "https://opencode.ai/config.json",
  // default model
  "model": "copilot/claude-4-5-haiku-latest",
  "provider": {
    // to launch a local model run:
    // export OLLAMA_CONTEXT_LENGTH=65536
    // ollama serve
    // ollama run gemma4:e4b
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "num_ctx": 32000
      },
      "models": {
        "qwen3.5:9b": {
            "name": "Qwen 3.5 9B"
        },
        "gemma4:e4b": {
            "name": "Gemma 4 E4B"
        }
      }
    }
  },
  // "model": "opencode/pig-pickle",
  // requires ANTHROPIC_API_KEY
  // "model": "anthropic/claude-4-5-haiku-latest",
  // "small_model": "anthropic/claude-4-5-haiku-latest",
  // "theme": "opencode",
  "autoupdate": true,
  "permission": {
    "edit": "ask",
    "read": "allow",
    "bash": {
      "git *": "ask",
      "npm *": "ask",
      "rm *": "deny",
      "*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "deny",
      "~/**": "deny"
    }
  },
  "agent": {
      "chat": {
          "mode": "primary",
          "temperature": 0.6,
          "prompt": "You are a helpful assisistant in a chat interface.  Do not edit files directly, but you can suggest new code and changes.  Prefer to read documentation on the web if you are unsure.",
          "tools": {
              "read": true,
              "write": false,
              "edit": false
          }
      }
  }
}
