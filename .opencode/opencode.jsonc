{
  "$schema": "https://opencode.ai/config.json",
  "model": "copilot/claude-4-5-haiku-latest",
  // "model": "opencode/pig-pickle",
  // requires ANTHROPIC_API_KEY
  // "model": "anthropic/claude-4-5-haiku-latest",
  // "small_model": "anthropic/claude-4-5-haiku-latest",
  "theme": "solarized",
  "autoupdate": true,
  "permission": {
    "edit": "ask",
    "read": "allow",
    "bash": {
      "git *": "ask",
      "npm *": "ask",
      "rm *": "deny",
      "*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "deny",
      "~/**": "deny"
    }
  },
  "agent": {
      "chat": {
          "mode": "primary",
          "temperature": 0.6,
          "prompt": "You are a helpful assisistant in a chat interface.  Do not edit files directly, but you can suggest new code and changes.  Prefer to read documentation on the web if you are unsure.",
          "tools": {
              "read": true,
              "write": false,
              "edit": false
          }
      }
  }
}
